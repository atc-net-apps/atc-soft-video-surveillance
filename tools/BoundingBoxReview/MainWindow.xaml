<atc:NiceWindow
    x:Class="BoundingBoxReview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:BoundingBoxReview"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="{Binding Path=Title}"
    Width="1400"
    Height="860"
    MinWidth="900"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=app:MainWindowViewModel}"
    Icon="pack://application:,,,/AtcSoft.Video.Surveillance.Wpf.Core;component/Resources/Images/cctv-camera.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <atc:NiceWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </atc:NiceWindow.Resources>

    <atc:NiceWindow.InputBindings>
        <KeyBinding Key="Left" Command="{Binding Path=PreviousCommand}" />
        <KeyBinding Key="Right" Command="{Binding Path=NextCommand}" />
        <KeyBinding
            Key="N"
            Command="{Binding Path=NothingHereCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="Z"
            Command="{Binding Path=UndoLastCommand}"
            Modifiers="Control" />
    </atc:NiceWindow.InputBindings>

    <DockPanel Margin="8">

        <!--  Make pictures, open a review, compare  -->
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <Button
                Padding="10,4"
                Command="{Binding Path=OpenRecordingCommand}"
                Content="Open recording..."
                ToolTip="Make the review pictures of a recording (or open its review, when it has one)" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Every" />
            <TextBox
                Width="40"
                VerticalAlignment="Center"
                Text="{Binding Path=EverySeconds, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="4,0,12,0"
                VerticalAlignment="Center"
                Text="s" />
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Text="Sensitivity" />
            <TextBox
                Width="40"
                VerticalAlignment="Center"
                Text="{Binding Path=SensitivityText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Empty: as in the settings.json found beside the recording" />
            <Button
                Margin="24,0,0,0"
                Padding="10,4"
                Command="{Binding Path=OpenFolderCommand}"
                Content="Open review folder..." />
            <Button
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding Path=CompareCommand}"
                Content="Compare" />
            <Button
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding Path=OpenInExplorerCommand}"
                Content="Show folder" />
            <CheckBox
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Content="Show the detector's boxes (yellow)"
                IsChecked="{Binding Path=ShowDetector}" />
        </StackPanel>

        <!--  Status and the comparison  -->
        <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Path=Status}" TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                FontWeight="SemiBold"
                Text="{Binding Path=CompareText}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  The pictures  -->
        <ListBox
            Width="220"
            Margin="0,0,8,0"
            DockPanel.Dock="Left"
            ItemsSource="{Binding Path=Pictures}"
            SelectedItem="{Binding Path=Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type app:PictureItem}">
                    <StackPanel Margin="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Path=Label}" />
                        <TextBlock Opacity="0.7" Text="{Binding Path=State}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  What the person says about the picture  -->
        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <TextBlock
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                Text="Comment (what moves, what is still; leave empty when nothing changed since the picture before)" />
            <TextBox
                Height="64"
                AcceptsReturn="True"
                IsEnabled="{Binding Path=HasReview}"
                Text="{Binding Path=Selected.Comment, UpdateSourceTrigger=PropertyChanged, FallbackValue={x:Static sys:String.Empty}}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </DockPanel>

        <!--  Step through the pictures  -->
        <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                Padding="10,4"
                Command="{Binding Path=PreviousCommand}"
                Content="Previous (Left)" />
            <Button
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding Path=NextCommand}"
                Content="Next (Right)" />
            <Button
                Margin="24,0,0,0"
                Padding="10,4"
                Command="{Binding Path=NothingHereCommand}"
                Content="Nothing to box here (Ctrl+N)" />
            <Button
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding Path=UndoLastCommand}"
                Content="Undo last box (Ctrl+Z)" />
            <Button
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding Path=ReopenCommand}"
                Content="Mark as not reviewed" />
        </StackPanel>

        <!--  The picture, the detector's boxes and the person's: everything in the video's pixels  -->
        <Viewbox Stretch="Uniform">
            <Grid
                x:Name="Surface"
                Width="{Binding Path=PictureWidth}"
                Height="{Binding Path=PictureHeight}"
                Background="Transparent"
                Cursor="Cross"
                MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
                MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
                MouseMove="OnSurfaceMouseMove">
                <Image Source="{Binding Path=Image}" Stretch="Fill" />

                <ItemsControl
                    IsHitTestVisible="False"
                    ItemsSource="{Binding Path=Selected.Detector, FallbackValue={x:Null}}"
                    Visibility="{Binding Path=ShowDetector, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Path=X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Path=Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:BoxView}">
                            <Rectangle
                                Width="{Binding Path=Width}"
                                Height="{Binding Path=Height}"
                                Stroke="Yellow"
                                StrokeThickness="4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Path=Selected.Person, FallbackValue={x:Null}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Path=X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Path=Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:BoxView}">
                            <Rectangle
                                Width="{Binding Path=Width}"
                                Height="{Binding Path=Height}"
                                Fill="#22FF0000"
                                MouseRightButtonUp="OnPersonBoxRightClick"
                                Stroke="Red"
                                StrokeThickness="4"
                                ToolTip="Right-click to remove" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Path=Drawing}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Path=X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Path=Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:BoxView}">
                            <Rectangle
                                Width="{Binding Path=Width}"
                                Height="{Binding Path=Height}"
                                Stroke="Red"
                                StrokeDashArray="3 2"
                                StrokeThickness="4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>

    </DockPanel>
</atc:NiceWindow>
