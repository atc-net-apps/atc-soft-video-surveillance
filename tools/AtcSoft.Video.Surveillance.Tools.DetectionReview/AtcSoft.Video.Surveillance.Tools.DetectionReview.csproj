<Project Sdk="Microsoft.NET.Sdk">

  <!-- A developer tool for tuning motion detection on real recordings: pictures of a recording
       with the detector's boxes (yellow), a person draws where the boxes should be (red), and the
       two are compared. Never shipped, not translated. See README.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AtcSoft.Video.Surveillance.Tools.DetectionReview</RootNamespace>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>..\..\src\AtcSoft.Video.Surveillance.Wpf.Core\Resources\Images\cctv-camera.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AtcSoft.Video.Surveillance.Storybook\AtcSoft.Video.Surveillance.Storybook.csproj" />
    <ProjectReference Include="..\..\src\AtcSoft.Video.Surveillance.Wpf.Core\AtcSoft.Video.Surveillance.Wpf.Core.csproj" />
  </ItemGroup>

</Project>
