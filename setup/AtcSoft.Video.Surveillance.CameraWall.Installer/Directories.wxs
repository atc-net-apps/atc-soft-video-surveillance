<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="AtcSoft">
        <Directory Id="INSTALLFOLDER" Name="Camera Wall" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AtcSoft Camera Wall" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- The app's data folder (ApplicationPaths): settings, cameras, recordings and logs.
         Created here so every user of the PC can write to it, not only the first one to start the app. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataManufacturerFolder" Name="AtcSoft">
        <Directory Id="DATAFOLDER" Name="CameraWall" />
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
