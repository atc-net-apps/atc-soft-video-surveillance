<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS as a reverse proxy in front of the AtcSoft Video Surveillance server (the Windows service on
  port 8585): the company's certificate, port 443 and host name in IIS, the server behind it.
  The server itself never runs inside IIS: an application pool stops, recycles and overlaps, and
  each of those stops or doubles the recordings.

  Needs the IIS modules URL Rewrite and Application Request Routing (ARR), with the proxy turned on
  (IIS Manager > the server > Application Request Routing Cache > Server Proxy Settings > Enable
  proxy). At that same place, set "Response buffer threshold" to 0, or the live events
  (/events) arrive in bursts. ARR passes the client's address as X-Forwarded-For; the server
  trusts it from this machine without any setting.

  The rule below sets X-Forwarded-Proto, so the server knows the browser came over HTTPS: add
  HTTP_X_FORWARDED_PROTO to the site's allowed server variables (URL Rewrite > View Server
  Variables > Add). See the wiki's IIS guide.

  Under a path of an existing site (an application "surveillance" with this web.config): add
  <set name="HTTP_X_FORWARDED_PREFIX" value="/surveillance" /> below, and allow that server
  variable too. The server then writes its pages for that path.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="AtcSoft Video Surveillance server" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:8585/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- The event stream must leave as it is written; the server compresses what it should. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <security>
      <!-- A recording's path may hold a "+" or an escaped character, which IIS refuses otherwise. -->
      <requestFiltering allowDoubleEscaping="true" />
    </security>
  </system.webServer>
</configuration>