<atcTheming:NiceWindow
    x:Class="AtcSoft.CameraWall.Wpf.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:AtcSoft.CameraWall.Wpf.App"
    xmlns:atcTheming="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:cw="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.UserControls;assembly=AtcSoft.VideoSurveillance.Wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="urn:fluent-ribbon"
    xmlns:fontIcons="clr-namespace:Atc.Wpf.FontIcons;assembly=Atc.Wpf.FontIcons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title=".:: AtcSoft Camera Wall ::."
    Width="1500"
    Height="1000"
    MinWidth="700"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=app:MainWindowViewModel}"
    Icon="pack://application:,,,/AtcSoft.VideoSurveillance.Wpf.Core;component/Resources/Images/cctv-camera.ico"
    WindowStartupLocation="CenterScreen"
    WindowState="{Binding Path=WindowState}"
    mc:Ignorable="d">

    <!--  Keyboard shortcuts; F1 lists them (Translations.KeyboardShortcutsText)  -->
    <atcTheming:NiceWindow.InputBindings>
        <KeyBinding
            Key="D1"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="1"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D2"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="2"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D3"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="3"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D4"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="4"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D5"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="5"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D6"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="6"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D7"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="7"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D8"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="8"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D9"
            Command="{Binding Path=SelectLayoutCommand}"
            CommandParameter="9"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D0"
            Command="{Binding Path=SelectGridPresetCommand}"
            CommandParameter="0"
            Modifiers="Ctrl+Alt" />
        <KeyBinding
            Key="D1"
            Command="{Binding Path=SelectGridPresetCommand}"
            CommandParameter="1"
            Modifiers="Ctrl+Alt" />
        <KeyBinding
            Key="D2"
            Command="{Binding Path=SelectGridPresetCommand}"
            CommandParameter="2"
            Modifiers="Ctrl+Alt" />
        <KeyBinding
            Key="D3"
            Command="{Binding Path=SelectGridPresetCommand}"
            CommandParameter="3"
            Modifiers="Ctrl+Alt" />
        <KeyBinding
            Key="D4"
            Command="{Binding Path=SelectGridPresetCommand}"
            CommandParameter="4"
            Modifiers="Ctrl+Alt" />
        <KeyBinding Key="PageDown" Command="{Binding Path=NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding Path=PreviousPageCommand}" />
        <KeyBinding
            Key="N"
            Command="{Binding Path=AddCameraCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="N"
            Command="{Binding Path=NewLayoutCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="R"
            Command="{Binding Path=ShowRecordingsBrowserCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="T"
            Command="{Binding Path=ShowTimelineCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="OemComma"
            Command="{Binding Path=ShowSettingsCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F5" Command="{Binding Path=ReconnectAllCommand}" />
        <KeyBinding Key="F1" Command="{Binding Path=ShowKeyboardShortcutsCommand}" />
    </atcTheming:NiceWindow.InputBindings>

    <AdornerDecorator>
        <atcTheming:GridEx Rows="Auto,*,Auto">

            <!--  Ribbon  -->
            <fluent:Ribbon
                Grid.Row="0"
                AutomaticStateManagement="False"
                CanCustomizeQuickAccessToolBar="False"
                IsMinimized="{Binding Path=IsRibbonMinimized, Mode=TwoWay}"
                IsQuickAccessToolBarMenuDropDownVisible="False"
                IsQuickAccessToolBarVisible="False">
                <!--  Backstage  -->
                <fluent:Ribbon.Menu>
                    <fluent:Backstage x:Name="Backstage" IsOpenChanged="OnBackstageIsOpenChanged">
                        <fluent:BackstageTabControl>
                            <fluent:Button
                                Command="{Binding Path=ShowSettingsCommand}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                             Key=Settings}"
                                KeyTip="S">
                                <fluent:Button.Icon>
                                    <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Cog" />
                                </fluent:Button.Icon>
                            </fluent:Button>
                            <fluent:SeparatorTabItem />
                            <fluent:Button
                                Command="{Binding Path=ShowAboutCommand}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                             Key=About}"
                                KeyTip="A">
                                <fluent:Button.Icon>
                                    <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="InfoCircle" />
                                </fluent:Button.Icon>
                            </fluent:Button>
                            <fluent:Button
                                Command="{Binding Path=CheckForUpdatesCommand}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                             Key=CheckForUpdates}"
                                KeyTip="C">
                                <fluent:Button.Icon>
                                    <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="CloudDownloadAlt" />
                                </fluent:Button.Icon>
                            </fluent:Button>
                            <fluent:SeparatorTabItem />
                            <fluent:Button
                                Command="{Binding Path=ExitCommand}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                             Key=Exit}"
                                KeyTip="X">
                                <fluent:Button.Icon>
                                    <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="SignOutAlt" />
                                </fluent:Button.Icon>
                            </fluent:Button>
                        </fluent:BackstageTabControl>
                    </fluent:Backstage>
                </fluent:Ribbon.Menu>

                <!--  Layouts Tab  -->
                <fluent:RibbonTabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Layouts}">
                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=CurrentLayoutGroup}">
                        <atcTheming:LabelComboBox
                            Width="250"
                            Margin="5,25,5,25"
                            HideAreas="All"
                            Items="{Binding Path=LayoutItems}"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                            Key=Layout}"
                            LabelWidthNumber="50"
                            SelectedKey="{Binding Path=SelectedLayoutId}" />
                    </fluent:RibbonGroupBox>

                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GridSizeGroup}">
                        <atcTheming:LabelComboBox
                            Width="250"
                            Margin="5,25,5,25"
                            HideAreas="All"
                            Items="{Binding Path=GridPresetItems}"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                            Key=GridSize}"
                            LabelWidthNumber="50"
                            SelectedKey="{Binding Path=SelectedGridPreset}"
                            ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                          Key=GridSizeInfo}" />
                        <fluent:Button
                            Command="{Binding Path=PreviousPageCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=PreviousPage}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="ChevronLeft" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=NextPageCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=NextPage}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="ChevronRight" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                    </fluent:RibbonGroupBox>

                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Actions}">
                        <fluent:Button
                            Command="{Binding Path=NewLayoutCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=NewLayout}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="PlusCircle" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=RenameLayoutCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=RenameLayout}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Edit" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=AssignCameraCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=AssignCamera}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Link" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=DeleteLayoutCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=DeleteLayout}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="TrashAlt" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=SetAsStartupCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=SetAsStartup}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Star" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                    </fluent:RibbonGroupBox>
                </fluent:RibbonTabItem>

                <!--  Cameras Tab  -->
                <fluent:RibbonTabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Cameras}">
                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Camera}">
                        <fluent:Button
                            Command="{Binding Path=AddCameraCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=AddCamera}"
                            Size="Large">
                            <fluent:Button.LargeIcon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Camera" />
                            </fluent:Button.LargeIcon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=AddUsbCameraCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=AddUsbCamera}"
                            Size="Large">
                            <fluent:Button.LargeIcon>
                                <!--
                                    Usb glyph lives in the FA Brand set, not Solid; using
                                    ImageAwesomeBrand here keeps consistency with the rest
                                    of the ribbon (FA Solid for Camera, Cog, etc.).
                                -->
                                <fontIcons:ImageAwesomeBrand Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Usb" />
                            </fluent:Button.LargeIcon>
                        </fluent:Button>
                    </fluent:RibbonGroupBox>

                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Actions}">
                        <fluent:Button
                            Command="{Binding Path=ReconnectAllCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=ReconnectAll}"
                            Size="Middle">
                            <fluent:Button.Icon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="SyncAlt" />
                            </fluent:Button.Icon>
                        </fluent:Button>
                    </fluent:RibbonGroupBox>
                </fluent:RibbonTabItem>

                <!--  View Tab  -->
                <fluent:RibbonTabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=View}">
                    <fluent:RibbonGroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Recordings}">
                        <fluent:Button
                            Command="{Binding Path=ShowRecordingsBrowserCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=BrowseRecordings}"
                            Size="Large">
                            <fluent:Button.LargeIcon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="Film" />
                            </fluent:Button.LargeIcon>
                        </fluent:Button>
                        <fluent:Button
                            Command="{Binding Path=ShowTimelineCommand}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                         Key=Timeline}"
                            Size="Large">
                            <fluent:Button.LargeIcon>
                                <fontIcons:ImageAwesomeSolid Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}" Icon="History" />
                            </fluent:Button.LargeIcon>
                        </fluent:Button>
                    </fluent:RibbonGroupBox>
                </fluent:RibbonTabItem>
            </fluent:Ribbon>

            <!--  Camera Grid  -->
            <cw:CameraGrid
                x:Name="CameraGridControl"
                Grid.Row="1"
                CameraConfigurationChanged="CameraGrid_CameraConfigurationChanged"
                ConnectionStateChanged="CameraGrid_ConnectionStateChanged"
                DeleteCameraRequested="CameraGrid_DeleteCameraRequested"
                EditCameraRequested="CameraGrid_EditCameraRequested"
                FullScreenRequested="CameraGrid_FullScreenRequested"
                PositionChanged="CameraGrid_PositionChanged" />

            <!--  Status Bar  -->
            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock Text="{Binding Path=StatusText}" />
                </StatusBarItem>
                <Separator />
                <StatusBarItem>
                    <TextBlock>
                        <Run Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=CamerasLabel}" />
                        <Run Text=" " /><Run Text="{Binding Path=CameraCount, Mode=OneWay}" />
                    </TextBlock>
                </StatusBarItem>
                <Separator />
                <StatusBarItem>
                    <TextBlock>
                        <Run Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ConnectedLabel}" />
                        <Run Text=" " /><Run Text="{Binding Path=ConnectedCount, Mode=OneWay}" />
                    </TextBlock>
                </StatusBarItem>
                <Separator Visibility="{Binding Path=HasDiskSpace, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                <StatusBarItem ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=DiskSpaceInfo}" Visibility="{Binding Path=HasDiskSpace, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsDiskSpaceLow}" Value="True">
                                        <Setter Property="Foreground" Value="OrangeRed" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=DiskSpaceLabel}" />
                        <Run Text=" " /><Run Text="{Binding Path=DiskSpaceText, Mode=OneWay}" />
                    </TextBlock>
                </StatusBarItem>
                <Separator Visibility="{Binding Path=HasPages, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                <StatusBarItem Visibility="{Binding Path=HasPages, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                    <TextBlock>
                        <Run Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PageLabel}" />
                        <Run Text=" " /><Run Text="{Binding Path=PageLabel, Mode=OneWay}" />
                    </TextBlock>
                </StatusBarItem>
                <StatusBarItem
                    Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    Visibility="{Binding Path=IsUpdateAvailable, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                    <TextBlock>
                        <Hyperlink Command="{Binding Path=DownloadUpdateCommand}">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <!--  Amber signals "attention" and stays readable on both dark and light statusbar backgrounds, regardless of accent color.  -->
                                    <Setter Property="Foreground" Value="#FFC107" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FFE082" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=UpdateAvailable}" />
                            <Run Text=": v" />
                            <Run Text="{Binding Path=UpdateVersion, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </atcTheming:GridEx>
    </AdornerDecorator>
</atcTheming:NiceWindow>