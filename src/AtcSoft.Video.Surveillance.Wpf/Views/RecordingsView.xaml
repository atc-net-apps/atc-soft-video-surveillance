<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.Views.RecordingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:coreControls="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.UserControls;assembly=AtcSoft.Video.Surveillance.Wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AtcSoft.Video.Surveillance.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:RecordingsViewModel}"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid Margin="16">
        <atc:GridEx Rows="Auto,*,Auto">

            <!--  Filter Row  -->
            <atc:GridEx
                Grid.Row="0"
                Margin="0,0,0,16"
                Columns="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!--  None ticked lists every camera  -->
                <atc:LabelMultiSelectComboBox
                    Grid.Column="0"
                    Width="300"
                    VerticalAlignment="Center"
                    HideAreas="All"
                    Items="{Binding Path=CameraFilters}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Camera}"
                    LabelWidthSizeDefinition="Auto"
                    NoneText="{Binding Path=AllCamerasText}"
                    SelectedKeys="{Binding Path=SelectedCameraFilters}" />
                <atc:LabelComboBox
                    Grid.Column="1"
                    Width="220"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    HideAreas="All"
                    Items="{Binding Path=DayFilterItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Day}"
                    LabelWidthSizeDefinition="Auto"
                    SelectedKey="{Binding Path=SelectedDayFilter, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelComboBox
                    Grid.Column="2"
                    Width="220"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    HideAreas="All"
                    Items="{Binding Path=TimeFilterItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Time}"
                    LabelWidthSizeDefinition="Auto"
                    SelectedKey="{Binding Path=SelectedTimeFilter, UpdateSourceTrigger=PropertyChanged}" />
                <!--  Searches every column of the list as you type  -->
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="3"
                    Width="200"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    atc:TextBoxHelper.ClearTextButton="True"
                    atc:TextBoxHelper.Watermark="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Search}"
                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Search}"
                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=SearchAllColumnsToolTip}" />
                <!--  Plays the selected recording; a double click on a row does the same  -->
                <Button
                    Grid.Column="5"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding Path=PlayCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=PlayRecording}" />
                <Button
                    Grid.Column="6"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding Path=AnalyseCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=AnalyseRecording}" />
                <Button
                    Grid.Column="7"
                    Padding="16,6"
                    Command="{Binding Path=RefreshCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Refresh}" />
            </atc:GridEx>

            <!--  Recordings DataGrid  -->
            <DataGrid
                Grid.Row="1"
                atc:DataGridFilter.IsEnabled="True"
                atc:DataGridFilter.SearchText="{Binding ElementName=SearchBox, Path=Text}"
                atc:DataGridFilter.ShowColumnChooser="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding Path=FilteredRecordings}"
                RowHeight="68"
                SelectedItem="{Binding Path=SelectedRecording}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <!--  Fetched from the server; empty for a recording without a thumbnail  -->
                    <DataGridTemplateColumn Width="90" Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Thumbnail}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image
                                    Width="80"
                                    Height="60"
                                    Margin="2"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Path=ThumbnailUrl, TargetNullValue={x:Null}}"
                                    Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Path=CameraName}"
                        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Camera}" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Path=LocalRecordingTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=RecordingDateTime}" />
                    <DataGridTextColumn
                        Width="80"
                        atc:DataGridFilter.IsColumnFilterEnabled="False"
                        Binding="{Binding Path=FormattedDuration}"
                        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=RecordingDuration}" />
                    <DataGridTemplateColumn Width="84" Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ActivityTimeline}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <coreControls:ActivitySparklineBars
                                    Height="18"
                                    Margin="4,2"
                                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ActivityTimeline}"
                                    Levels="{Binding Path=Activity}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        atc:DataGridFilter.IsColumnFilterEnabled="False"
                        Binding="{Binding Path=FormattedFileSize}"
                        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=RecordingSize}" />
                    <DataGridTextColumn
                        Width="*"
                        atc:DataGridFilter.IsColumnFilterEnabled="False"
                        Binding="{Binding Path=FileName}"
                        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=FileName}" />
                </DataGrid.Columns>
                <DataGrid.InputBindings>
                    <MouseBinding Command="{Binding Path=PlayCommand}" MouseAction="LeftDoubleClick" />
                </DataGrid.InputBindings>
            </DataGrid>

            <!--  Status Message  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,8,0,0"
                Foreground="{DynamicResource AtcApps.Brushes.Gray5}"
                Text="{Binding Path=StatusMessage}" />

        </atc:GridEx>

        <!--  Loading overlay  -->
        <Border Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=LoadingRecordings}" />
        </Border>
    </Grid>
</UserControl>