<atc:NiceWindow
    x:Class="AtcSoft.Video.Surveillance.Wpf.Dialogs.HubCameraDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=CameraHubHeader}"
    Width="720"
    MinHeight="300"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance Type=dialogs:HubCameraDialogViewModel}"
    mc:Ignorable="d">

    <StackPanel Margin="16">
        <TextBlock
            Margin="0,0,0,10"
            Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=CameraHubHelp}"
            TextWrapping="Wrap" />

        <atc:GridEx Columns="2*,16,*,16,*,16,Auto" Rows="Auto">
            <atc:LabelTextBox
                Grid.Column="0"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Address}"
                Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <atc:LabelTextBox
                Grid.Column="2"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Username}"
                Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <atc:LabelPasswordBox
                Grid.Column="4"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Password}"
                Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="6"
                MinWidth="100"
                VerticalAlignment="Bottom"
                Command="{Binding ConnectCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Connect}"
                IsDefault="True" />
        </atc:GridEx>

        <TextBlock
            Margin="0,10,0,0"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,4,0,0"
            Foreground="DarkOrange"
            Text="{Binding Warning}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,4,0,0"
            Foreground="IndianRed"
            Text="{Binding Problem}"
            TextWrapping="Wrap" />

        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Cameras}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs:HubCameraRowViewModel}">
                    <Border
                        Width="210"
                        Margin="0,0,10,10"
                        Padding="8"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <StackPanel>
                            <Image
                                Height="110"
                                Source="{Binding Picture}"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Opacity="0.7" Text="{Binding Details}" />
                            <TextBlock
                                Foreground="IndianRed"
                                Text="{Binding Problem}"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,6,0,0"
                                Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=AddCamera}"
                                IsEnabled="{Binding CanAdd}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="80"
                Command="{Binding CancelCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Cancel}"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</atc:NiceWindow>
