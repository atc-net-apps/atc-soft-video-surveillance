<UserControl
    x:Class="AtcSoft.VideoSurveillance.Wpf.UserControls.CameraTileBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcNetworkValueConverters="clr-namespace:Atc.Wpf.Network.ValueConverters;assembly=Atc.Wpf.Network"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:coreControls="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.UserControls;assembly=AtcSoft.VideoSurveillance.Wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lve="clr-namespace:AtcSoft.VideoPlayer.Wpf;assembly=AtcSoft.VideoPlayer.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AtcSoft.VideoSurveillance.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:CameraTileViewModel}"
    mc:Ignorable="d">

    <!--  ReSharper disable Xaml.BindingWithContextNotResolved  -->
    <Grid Background="Black">
        <!--  Video Player with visual overlay inside (required due to DirectX airspace)  -->
        <lve:VideoHost Player="{Binding Player}">
            <!--  Visual overlay content - renders on top of video  -->
            <Grid Background="Transparent">
                <!--  Camera Info Overlay (Top-Left)  -->
                <Border
                    Margin="8"
                    Padding="6,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#99000000"
                    CornerRadius="3">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding Path=HostDataContext.DisplayName}" />
                        <!--  Connection status dot + text  -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=HostDataContext.ConnectionState, Converter={x:Static atcNetworkValueConverters:ConnectionStateToColorValueConverter.Instance}}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="9"
                                Foreground="#AAAAAA"
                                Text="{Binding Path=HostDataContext.ConnectionState, Converter={x:Static atcNetworkValueConverters:ConnectionStateToTextValueConverter.Instance}}" />
                            <!--  Connection-type glyph (LAN / Wi-Fi / USB), inline next to the status, tinted by link health  -->
                            <coreControls:ConnectionTypeIcon
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ConnectionState="{Binding Path=HostDataContext.ConnectionState}"
                                ConnectionType="{Binding Path=HostDataContext.DisplayedConnectionType}"
                                IconSize="10"
                                ShowBackground="False" />
                        </StackPanel>

                        <!--  Recording indicator (red dot, visible when IsRecording)  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.IsRecording}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="Red" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="Red"
                                Text="{Binding Path=HostDataContext.RecordingDurationText}" />
                        </StackPanel>
                        <!--  USB device-unplugged indicator (visible when the watcher reports the device is gone)  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.IsDeviceUnplugged}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                Margin="0,0,4,0"
                                FontSize="10"
                                Foreground="#FFB347"
                                Text="🔌" />
                            <TextBlock
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#FFB347"
                                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                            Key=UsbDeviceUnplugged}" />
                        </StackPanel>

                        <!--  Motion indicator (orange dot, visible when IsMotionDetected)  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.IsMotionDetected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="Orange" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="9"
                                Foreground="Orange"
                                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=MotionBadge}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Motion bounding box overlay  -->
                <coreControls:MotionBoundingBoxOverlay
                    AnalysisHeight="{Binding Path=HostDataContext.AnalysisHeight}"
                    AnalysisWidth="{Binding Path=HostDataContext.AnalysisWidth}"
                    MotionBoxes="{Binding Path=HostDataContext.CurrentBoundingBoxes}"
                    IsHitTestVisible="False"
                    VideoHeight="{Binding Path=HostDataContext.MotionVideoHeight}"
                    VideoWidth="{Binding Path=HostDataContext.MotionVideoWidth}" />
            </Grid>
        </lve:VideoHost>

        <!--  "No stream" placeholder when not streaming  -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="#666666"
            Text="{Binding Path=PlaceholderText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStreaming}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
    <!--  ReSharper restore Xaml.BindingWithContextNotResolved  -->
</UserControl>