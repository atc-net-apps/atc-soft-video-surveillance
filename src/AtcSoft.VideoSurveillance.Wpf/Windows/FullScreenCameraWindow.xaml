<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Windows.FullScreenCameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lve="clr-namespace:AtcSoft.VideoPlayer.Wpf;assembly=AtcSoft.VideoPlayer.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:coreControls="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.UserControls;assembly=AtcSoft.VideoSurveillance.Wpf.Core"
    xmlns:windows="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Windows"
    Title="{Binding Path=CameraName}"
    d:DataContext="{d:DesignInstance Type=windows:FullScreenCameraWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    AllowsTransparency="False"
    IgnoreTaskbarOnMaximize="True"
    Background="Black"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    UseNoneWindowStyle="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <atc:NiceWindow.Resources>
        <ResourceDictionary Source="/AtcSoft.VideoSurveillance.Wpf.Core;component/Themes/FullScreenStyles.xaml" />
    </atc:NiceWindow.Resources>

    <!--  ReSharper disable Xaml.BindingWithContextNotResolved  -->
    <Grid x:Name="RootGrid">
        <!--  Video Player with visual overlay inside (required due to DirectX airspace)  -->
        <lve:VideoHost
            x:Name="VideoPlayer"
            Player="{Binding Path=Player}">

            <!--  Visual overlay content - renders on top of video  -->
            <Grid Background="Transparent">
                <!--  Camera Info Overlay (Top-Left)  -->
                <Border
                    x:Name="OverlayBorder"
                    Margin="20"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#B3000000"
                    CornerRadius="4"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}">
                    <StackPanel Orientation="Vertical">
                        <!--  Camera Title  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding Path=HostDataContext.CameraName}" />
                        <!--  Camera Description  -->
                        <TextBlock
                            FontSize="12"
                            Foreground="#AAAAAA"
                            Text="{Binding Path=HostDataContext.CameraDescription}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.CameraDescription}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--  Connection Status  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0"
                                Fill="{Binding Path=HostDataContext.ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#AAAAAA"
                                Text="{Binding Path=HostDataContext.ConnectionState, Converter={StaticResource ConnectionStateToTextConverter}}" />
                        </StackPanel>
                        <!--  Recording indicator  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.IsRecording}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,2,6,0"
                                Fill="Red" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="Red"
                                Text="{Binding Path=HostDataContext.RecordingDurationText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Motion Bounding Box Overlay  -->
                <coreControls:MotionBoundingBoxOverlay
                    x:Name="MotionOverlay"
                    AnalysisHeight="{Binding Path=HostDataContext.AnalysisHeight}"
                    AnalysisWidth="{Binding Path=HostDataContext.AnalysisWidth}"
                    IsHitTestVisible="False" />

                <!--  Close Button (Top-Right)  -->
                <Button
                    AutomationProperties.Name="Close"
                    Width="40"
                    Height="40"
                    Margin="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding Path=HostDataContext.CloseCommand}"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}"
                    Style="{StaticResource FullScreenCloseButtonStyle}"
                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Close}">
                    <Path
                        Width="14"
                        Height="14"
                        Data="M0,0 L14,14 M14,0 L0,14"
                        Stroke="White"
                        StrokeThickness="2" />
                </Button>

                <!--  ESC hint at bottom  -->
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="#66FFFFFF"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}"
                    Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PressEscToExit}" />
            </Grid>
        </lve:VideoHost>
    </Grid>
    <!--  ReSharper restore Xaml.BindingWithContextNotResolved  -->
</atc:NiceWindow>