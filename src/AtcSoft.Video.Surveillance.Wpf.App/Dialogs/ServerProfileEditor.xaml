<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.App.Dialogs.ServerProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.App.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:ServerProfileEditorViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Path=CancelCommand}" />
    </UserControl.InputBindings>

    <!--  A server profile, edited inside the server connection dialog: a dialog opens no other window  -->
    <Border
        Width="420"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
        BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
        BorderThickness="1"
        CornerRadius="4">
        <atc:GridEx Rows="Auto,Auto,Auto,Auto,Auto">

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ServerProfile}" />

            <!--  Name  -->
            <atc:LabelTextBox
                Grid.Row="1"
                Margin="0,0,0,12"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Name}"
                Text="{Binding Path=ProfileName, UpdateSourceTrigger=PropertyChanged}" />

            <!--  URL  -->
            <atc:LabelTextBox
                Grid.Row="2"
                Margin="0,0,0,12"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ServerUrl}"
                Text="{Binding Path=Url, UpdateSourceTrigger=PropertyChanged}"
                WatermarkText="http://server:8585" />

            <!--  Description  -->
            <atc:LabelTextBox
                Grid.Row="3"
                Margin="0,0,0,20"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Description}"
                Text="{Binding Path=Description, UpdateSourceTrigger=PropertyChanged}"
                WatermarkText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=OptionalDescription}" />

            <!--  Buttons  -->
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Command="{Binding Path=SaveCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Save}" />
                <Button
                    MinWidth="80"
                    Padding="16,8"
                    Command="{Binding Path=CancelCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Cancel}" />
            </StackPanel>
        </atc:GridEx>
    </Border>
</UserControl>
