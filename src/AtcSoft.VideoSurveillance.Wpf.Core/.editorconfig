# ATC coding rules - https://github.com/atc-net/atc-coding-rules
# Version: 1.0.1
# Updated: 06-06-2024
# Location: wpf
# Distribution: Frameworks

##########################################
# Code Analyzers Rules
##########################################
[*.{cs}]

dotnet_diagnostic.CA2227.severity = none            # Change property to be read-only by removing the property setter - https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca2227

dotnet_diagnostic.MA0004.severity = error           # Use Task.ConfigureAwait(false) https://github.com/meziantou/Meziantou.Analyzer/blob/main/docs/Rules/MA0004.md
dotnet_diagnostic.MA0048.severity = none            # To support partial classes - File will not match type name.

##########################################
# Custom - Code Analyzers Rules
##########################################

# WPF UserControl code-behind: [DependencyProperty] backing fields are read
# by the source-generated property surface. CS-prefixed compiler warnings
# cannot be silenced via [SuppressMessage], so suppress per-file here.
[*.xaml.cs]
dotnet_diagnostic.CS0169.severity = none   # Field is never used
dotnet_diagnostic.CS0414.severity = none   # Field is assigned but never used

# The same for the controls drawn in code, without XAML.
[UserControls/{ActivitySparklineBars,ActivityTimeline,CameraTimelineLane,TimelineMarksBar}.cs]
dotnet_diagnostic.CS0169.severity = none   # Field is never used