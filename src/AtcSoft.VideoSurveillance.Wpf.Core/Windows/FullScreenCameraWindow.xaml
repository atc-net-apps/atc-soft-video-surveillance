<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Core.Windows.FullScreenCameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lve="clr-namespace:AtcSoft.VideoPlayer.Wpf;assembly=AtcSoft.VideoPlayer.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.UserControls"
    xmlns:valueConverters="clr-namespace:Atc.Wpf.ValueConverters;assembly=Atc.Wpf"
    xmlns:windows="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.Windows"
    Title="{Binding Path=CameraName}"
    d:DataContext="{d:DesignInstance Type=windows:FullScreenCameraWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    AllowsTransparency="False"
    IgnoreTaskbarOnMaximize="True"
    Background="Black"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    UseNoneWindowStyle="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <atc:NiceWindow.Resources>
        <ResourceDictionary Source="/AtcSoft.VideoSurveillance.Wpf.Core;component/Themes/FullScreenStyles.xaml" />
    </atc:NiceWindow.Resources>

    <!--  ReSharper disable Xaml.BindingWithContextNotResolved  -->
    <Grid x:Name="RootGrid">
        <!--  Video Player with visual overlay inside (required due to DirectX airspace)  -->
        <lve:VideoHost x:Name="VideoPlayer" Player="{Binding Path=Player}">

            <!--  Visual overlay content - renders on top of video  -->
            <Grid Background="Transparent">
                <!--  Camera Info Overlay (Top-Left)  -->
                <Border
                    x:Name="OverlayBorder"
                    Margin="20"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="4"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}">
                    <StackPanel Orientation="Vertical">
                        <!--  Camera Title  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding Path=HostDataContext.CameraName}"
                            Visibility="{Binding Path=HostDataContext.ShowOverlayTitle, Converter={x:Static valueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                        <!--  Camera Description (only shown if enabled AND not empty)  -->
                        <TextBlock
                            FontSize="12"
                            Foreground="#AAAAAA"
                            Text="{Binding Path=HostDataContext.CameraDescription}"
                            Visibility="{Binding Path=HostDataContext.ShowOverlayDescription, Converter={x:Static valueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HostDataContext.CameraDescription}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--  Current Time  -->
                        <TextBlock
                            x:Name="TimeDisplay"
                            FontSize="12"
                            Foreground="#AAAAAA"
                            Visibility="{Binding Path=HostDataContext.ShowOverlayTime, Converter={x:Static valueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                        <!--  Connection Status  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding Path=HostDataContext.ShowOverlayConnectionStatus, Converter={x:Static valueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0"
                                Fill="{Binding Path=HostDataContext.ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#AAAAAA"
                                Text="{Binding Path=HostDataContext.ConnectionState, Converter={StaticResource ConnectionStateToTextConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Motion Bounding Box Overlay  -->
                <userControls:MotionBoundingBoxOverlay
                    x:Name="MotionOverlay"
                    AnalysisHeight="{Binding Path=HostDataContext.AnalysisHeight}"
                    AnalysisWidth="{Binding Path=HostDataContext.AnalysisWidth}"
                    BoxColor="{Binding Path=HostDataContext.BoundingBoxColor}"
                    BoxThickness="{Binding Path=HostDataContext.BoundingBoxThickness}"
                    IsHitTestVisible="False"
                    IsOverlayEnabled="{Binding Path=HostDataContext.ShowBoundingBoxInFullScreen}"
                    SmoothingFactor="{Binding Path=HostDataContext.BoundingBoxSmoothing}" />

                <!--  Zoom Selection Rectangle  -->
                <Canvas
                    x:Name="ZoomSelectionCanvas"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Rectangle
                        x:Name="ZoomSelectionRect"
                        Fill="#22FFFFFF"
                        Stroke="#CCFFFFFF"
                        StrokeDashArray="4 2"
                        StrokeThickness="1.5" />
                </Canvas>

                <!--  Connection-type icon: a corner adjacent to the info box, avoiding the close button (set in ApplyOverlayPosition)  -->
                <userControls:ConnectionTypeIcon
                    x:Name="ConnectionTypeIconControl"
                    Margin="20"
                    ConnectionState="{Binding Path=HostDataContext.ConnectionState}"
                    ConnectionType="{Binding Path=HostDataContext.DisplayedConnectionType}"
                    IconSize="18"
                    IsHitTestVisible="False"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}" />

                <!--  Close Button (Top-Right)  -->
                <Button
                    AutomationProperties.Name="Close"
                    Width="40"
                    Height="40"
                    Margin="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding Path=HostDataContext.CloseCommand}"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}"
                    Style="{StaticResource FullScreenCloseButtonStyle}"
                    ToolTip="Close">
                    <Path
                        Width="14"
                        Height="14"
                        Data="M0,0 L14,14 M14,0 L0,14"
                        Stroke="White"
                        StrokeThickness="2" />
                </Button>

                <!--  ESC hint at bottom  -->
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="#66FFFFFF"
                    Opacity="{Binding Path=HostDataContext.IsOverlayVisible, Converter={x:Static atcValueConverters:BoolToOpacityValueConverter.Instance}}"
                    Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                               Key=PressEscToExit}" />
            </Grid>
        </lve:VideoHost>
    </Grid>
    <!--  ReSharper restore Xaml.BindingWithContextNotResolved  -->
</atc:NiceWindow>