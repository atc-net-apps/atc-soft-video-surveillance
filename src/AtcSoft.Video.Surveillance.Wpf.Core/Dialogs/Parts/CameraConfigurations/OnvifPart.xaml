<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.Core.Dialogs.Parts.CameraConfigurations.OnvifPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:CameraConfigurationDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <!--  ONVIF: find the cameras on the network, or read the streams of the one at the address typed  -->
    <atc:GroupBoxExpander
        x:Name="Onvif"
        Margin="0,0,0,20"
        Padding="0,15,0,0"
        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                     Key=OnvifHeader}"
        IsExpanded="False">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,10"
                Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                           Key=OnvifHelp}"
                TextWrapping="Wrap" />

            <atc:GridEx Columns="Auto,20,*,20,Auto" Rows="Auto">
                <Button
                    Grid.Column="0"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    Command="{Binding Path=FindOnvifCamerasCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                  Key=FindOnvifCameras}"
                    Visibility="{Binding Path=CanFindOnvifCameras, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                <atc:LabelIntegerBox
                    Grid.Column="2"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                    Key=OnvifPort}"
                    Maximum="65535"
                    Minimum="0"
                    Value="{Binding Path=OnvifPort, Mode=TwoWay}" />
                <Button
                    Grid.Column="4"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    Command="{Binding Path=ReadFromCameraCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                  Key=ReadFromCamera}" />
            </atc:GridEx>

            <TextBlock
                Margin="0,10,0,0"
                Text="{Binding Path=OnvifStatus}"
                TextWrapping="Wrap"
                Visibility="{Binding Path=OnvifStatus, Converter={x:Static atcValueConverters:StringNullOrEmptyToVisibilityCollapsedValueConverter.Instance}}" />

            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Path=OnvifDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:OnvifDeviceItem}">
                        <Button
                            Margin="0,0,0,4"
                            Padding="8,4"
                            HorizontalContentAlignment="Left"
                            Command="{Binding Path=DataContext.UseOnvifDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Path=Text}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </atc:GroupBoxExpander>
</UserControl>