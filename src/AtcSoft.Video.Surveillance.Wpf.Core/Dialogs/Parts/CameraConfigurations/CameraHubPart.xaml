<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.Core.Dialogs.Parts.CameraConfigurations.CameraHubPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:CameraConfigurationDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <!--  A camera of a camera hub (motionEye or motionEyeOS on a Raspberry Pi): list its cameras, pick one  -->
    <atc:GroupBoxExpander
        x:Name="CameraHub"
        Margin="0,0,0,20"
        Padding="0,15,0,0"
        Header="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                     Key=CameraHubHeader}"
        IsExpanded="False">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,10"
                Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                           Key=CameraHubHelp}"
                TextWrapping="Wrap" />

            <atc:GridEx
                Columns="2*,20,*,20,*,20,Auto"
                Rows="Auto">
                <atc:LabelTextBox
                    Grid.Column="0"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                    Key=Address}"
                    Text="{Binding Path=HubAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelTextBox
                    Grid.Column="2"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                    Key=Username}"
                    Text="{Binding Path=HubUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelPasswordBox
                    Grid.Column="4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                    Key=Password}"
                    Text="{Binding Path=HubPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="6"
                    MinWidth="100"
                    VerticalAlignment="Bottom"
                    Command="{Binding Path=ConnectHubCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                  Key=Connect}" />
            </atc:GridEx>

            <TextBlock
                Margin="0,10,0,0"
                Text="{Binding Path=HubStatus}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="DarkOrange"
                Text="{Binding Path=HubWarning}"
                TextWrapping="Wrap"
                Visibility="{Binding Path=HubWarning, Converter={x:Static atcValueConverters:StringNullOrEmptyToVisibilityCollapsedValueConverter.Instance}}" />

            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Path=HubCameras}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:HubCameraItem}">
                        <Border
                            Width="200"
                            Margin="0,0,10,10"
                            Padding="8"
                            BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                            BorderThickness="1">
                            <StackPanel>
                                <Image
                                    Height="110"
                                    Source="{Binding Path=Picture}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontWeight="SemiBold"
                                    Text="{Binding Path=Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Opacity="0.7" Text="{Binding Path=Details}" />
                                <TextBlock
                                    Foreground="IndianRed"
                                    Text="{Binding Path=Problem}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Path=Problem, Converter={x:Static atcValueConverters:StringNullOrEmptyToVisibilityCollapsedValueConverter.Instance}}" />
                                <Button
                                    Margin="0,6,0,0"
                                    Command="{Binding Path=DataContext.UseHubCameraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                                  Key=UseThisCamera}"
                                    IsEnabled="{Binding Path=CanUse}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </atc:GroupBoxExpander>
</UserControl>
