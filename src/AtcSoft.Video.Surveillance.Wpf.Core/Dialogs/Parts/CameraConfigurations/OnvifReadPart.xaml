<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.Core.Dialogs.Parts.CameraConfigurations.OnvifReadPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:CameraConfigurationDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <!--  ONVIF: read the streams of the camera at the address typed; the paths above are filled in  -->
    <StackPanel Margin="0,10,0,0">
        <TextBlock
            Margin="0,0,0,8"
            Opacity="0.8"
            Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                       Key=OnvifReadHelp}"
            TextWrapping="Wrap" />

        <atc:GridEx Columns="*,20,Auto" Rows="Auto">
            <atc:LabelIntegerBox
                Grid.Column="0"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                                Key=OnvifPort}"
                Maximum="65535"
                Minimum="0"
                Value="{Binding Path=OnvifPort, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                MinWidth="120"
                VerticalAlignment="Bottom"
                Command="{Binding Path=ReadFromCameraCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                              Key=ReadFromCamera}" />
        </atc:GridEx>

        <TextBlock
            Margin="0,8,0,0"
            Text="{Binding Path=OnvifReadStatus}"
            TextWrapping="Wrap"
            Visibility="{Binding Path=OnvifReadStatus, Converter={x:Static atcValueConverters:StringNullOrEmptyToVisibilityCollapsedValueConverter.Instance}}" />
    </StackPanel>
</UserControl>
