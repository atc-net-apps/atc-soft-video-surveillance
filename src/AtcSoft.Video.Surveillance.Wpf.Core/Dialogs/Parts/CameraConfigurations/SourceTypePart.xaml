<UserControl
    x:Class="AtcSoft.Video.Surveillance.Wpf.Core.Dialogs.Parts.CameraConfigurations.SourceTypePart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:CameraConfigurationDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <StackPanel
        Margin="0,0,0,15"
        Orientation="Horizontal">

        <TextBlock
            Margin="0,0,15,0"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                       Key=Source}" />

        <!--  The first segment is a network camera, the second a USB camera; set once, when the camera is added  -->
        <atc:Segmented
            VerticalAlignment="Center"
            EqualSegmentWidth="False"
            IsEnabled="{Binding Path=CanEditSource}"
            SelectedIndex="{Binding Path=SourceIndex, Mode=TwoWay}"
            Size="Small">
            <atc:SegmentedItem Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                          Key=SourceTypeNetwork}" />
            <atc:SegmentedItem Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations,
                                          Key=SourceTypeUsb}" />
        </atc:Segmented>

    </StackPanel>
</UserControl>