<atc:NiceWindow
    x:Class="AtcSoft.Video.Surveillance.CameraWall.Wpf.Timeline.LocalTimelineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:coreControls="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.UserControls;assembly=AtcSoft.Video.Surveillance.Wpf.Core"
    xmlns:coreWindows="clr-namespace:AtcSoft.Video.Surveillance.Wpf.Core.Windows;assembly=AtcSoft.Video.Surveillance.Wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="clr-namespace:Atc.Wpf.Controls.Inputs;assembly=Atc.Wpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:timeline="clr-namespace:AtcSoft.Video.Surveillance.CameraWall.Wpf.Timeline"
    Title="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Timeline}"
    Width="1280"
    Height="760"
    MinWidth="900"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=timeline:LocalTimelineViewModel,
                                     IsDesignTimeCreatable=False}"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <atc:NiceWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </atc:NiceWindow.Resources>

    <atc:NiceWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Path=ClosePlayAllCommand}" />
    </atc:NiceWindow.InputBindings>

    <Grid>
        <!--  The timeline  -->
        <atc:GridEx Margin="16" Rows="Auto,Auto,*,Auto">

            <!--  What the lanes show  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                Opacity="0.75"
                Text="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=TimelineHelp}"
                TextWrapping="Wrap" />

            <!--  The span, the events, play all  -->
            <DockPanel
                Grid.Row="1"
                Margin="0,0,0,12"
                LastChildFill="False">
                <ComboBox
                    Width="170"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Timeline}"
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding Path=SpanChoices}"
                    SelectedItem="{Binding Path=SelectedSpan, Mode=TwoWay}" />
                <DatePicker
                    Width="140"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Day}"
                    DockPanel.Dock="Left"
                    SelectedDate="{Binding Path=SelectedDay, Mode=TwoWay}"
                    Visibility="{Binding Path=IsDayChosen, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Margin="8,0,8,0"
                    Padding="16,6"
                    Command="{Binding Path=PreviousEventCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=PreviousEvent}"
                    DockPanel.Dock="Left" />
                <Button
                    Margin="0,0,16,0"
                    Padding="16,6"
                    Command="{Binding Path=NextEventCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=NextEvent}"
                    DockPanel.Dock="Left" />
                <Button
                    Padding="16,6"
                    Background="{DynamicResource AtcApps.Brushes.Accent}"
                    Command="{Binding Path=PlayAllCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=PlayAllFromHere}"
                    DockPanel.Dock="Left"
                    Foreground="White" />
                <Button
                    Padding="16,6"
                    Command="{Binding Path=LoadCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=Refresh}"
                    DockPanel.Dock="Right" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding Path=ResetZoomCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ResetZoom}"
                    DockPanel.Dock="Right" />
            </DockPanel>

            <!--  One lane per camera  -->
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Path=Lanes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type timeline:LocalTimelineLaneViewModel}">
                                <atc:GridEx Margin="0,0,0,4" Columns="160,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Path=CameraName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <coreControls:CameraTimelineLane
                                        Grid.Column="1"
                                        Height="36"
                                        AutomationProperties.Name="{Binding Path=CameraName}"
                                        EventBands="{Binding Path=EventBands}"
                                        NowFraction="{Binding Path=NowFraction}"
                                        SeekCommand="{Binding Path=PlayAtCommand}"
                                        Stretches="{Binding Path=Stretches}"
                                        ToolTip="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=TimelineHelp}" />
                                </atc:GridEx>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <atc:GridEx Columns="160,*">
                        <coreControls:TimelineMarksBar
                            Grid.Column="1"
                            Marks="{Binding Path=Marks}"
                            Opacity="0.75" />
                    </atc:GridEx>

                    <!--  Zoom: the part of the span shown, by its two ends, right under the lanes  -->
                    <atc:GridEx Margin="0,8,0,0" Columns="160,*">
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.75"
                            Text="{Binding Path=ShownText}"
                            TextWrapping="Wrap" />
                        <inputs:RangeSlider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ZoomRange}"
                            Maximum="{Binding Path=RangeMaximum}"
                            Minimum="0"
                            RangeEnd="{Binding Path=RangeEnd, Mode=TwoWay}"
                            RangeStart="{Binding Path=RangeStart, Mode=TwoWay}"
                            Step="1"
                            ToolTip="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=ZoomRange}" />
                    </atc:GridEx>
                </StackPanel>
            </ScrollViewer>

            <!--  Status  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                Text="{Binding Path=StatusMessage}" />
        </atc:GridEx>

        <!--  Play all from here, over the timeline: a dialog opens no other window  -->
        <atc:GridEx
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
            Rows="Auto,*,Auto"
            Visibility="{Binding Path=IsPlayingAll, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Grid.Row="0" Margin="8">
                <Button
                    Padding="12,6"
                    Command="{Binding Path=ClosePlayAllCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=BackToTimeline}"
                    DockPanel.Dock="Left" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{Binding Path=PlayAllSession.Title, FallbackValue=''}" />
            </DockPanel>

            <coreWindows:PlayAllView Grid.Row="1" DataContext="{Binding Path=PlayAllSession}" />

            <!--  Through the time shown: let go to play all from there  -->
            <StackPanel Grid.Row="2" Margin="16,8,16,12">
                <Slider
                    x:Name="PlayAllSlider"
                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=PlayAllPosition}"
                    IsMoveToPointEnabled="True"
                    Maximum="{Binding Path=PlayAllMaximum}"
                    Minimum="0"
                    PreviewMouseLeftButtonDown="OnPlayAllSliderDown"
                    PreviewMouseLeftButtonUp="OnPlayAllSliderUp"
                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.Video.Surveillance.Resources.Translations, Key=PlayAllPosition}"
                    Value="{Binding Path=PlayAllPosition, Mode=TwoWay}" />
                <coreControls:TimelineMarksBar Marks="{Binding Path=Marks}" Opacity="0.75" />
            </StackPanel>
        </atc:GridEx>
    </Grid>
</atc:NiceWindow>
