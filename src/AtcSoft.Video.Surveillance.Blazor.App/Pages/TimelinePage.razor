@page "/timeline"
@inject GatewayService Gateway
@inject BrowserSession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject EventStreamService EventStream
@implements IDisposable

<MudText Typo="Typo.h4" Class="mb-2">@Translations.Timeline</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">@Translations.TimelineHelp</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
    <MudSelect T="int"
               Label="@Translations.Timeline"
               Value="@spanHours"
               ValueChanged="OnSpanChangedAsync"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="max-width: 200px;">
        @foreach (var hours in SpanChoices)
        {
            <MudSelectItem T="int" Value="@hours">@TimelineSpans.Label(hours)</MudSelectItem>
        }
    </MudSelect>
    @if (spanHours == 0)
    {
        <MudDatePicker Label="@Translations.Day"
                       Date="@(day?.ToDateTime(TimeOnly.MinValue))"
                       DateChanged="OnDayChangedAsync"
                       MaxDate="@DateTime.Today"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="max-width: 200px;" />
    }
    <MudTooltip Text="@Translations.PreviousEvent">
        <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious"
                       aria-label="@Translations.PreviousEvent"
                       OnClick="@(() => JumpAsync(forward: false))" />
    </MudTooltip>
    <MudTooltip Text="@Translations.NextEvent">
        <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                       aria-label="@Translations.NextEvent"
                       OnClick="@(() => JumpAsync(forward: true))" />
    </MudTooltip>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.GridView"
               OnClick="PlayAllAsync">@Translations.PlayAllFromHere</MudButton>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.ZoomOutMap" OnClick="ResetZoomAsync">@Translations.ResetZoom</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">@Translations.Refresh</MudButton>
</MudStack>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (timeline is { } shown)
{
    @foreach (var lane in shown.Lanes)
    {
        <div class="d-flex align-center mb-1">
            <MudText Typo="Typo.body2" Style="width: 160px; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@lane.CameraName</MudText>
            <svg id="@LaneId(lane)"
                 role="img"
                 aria-label="@lane.CameraName"
                 viewBox="0 0 @lane.Buckets.Count @SvgNumber.Format(ActivityTimelineShapes.BoxHeight)"
                 preserveAspectRatio="none"
                 style="flex: 1; height: 36px; cursor: pointer; background: rgba(128,128,128,0.06);"
                 @onclick="@(e => PlayAtAsync(lane, e))">
                @foreach (var gap in TimelineLaneShapes.Gaps(lane, span))
                {
                    <rect x="@SvgNumber.Format(gap.Rect.X)" y="@SvgNumber.Format(gap.Rect.Y)" width="@SvgNumber.Format(gap.Rect.Width)" height="@SvgNumber.Format(gap.Rect.Height)" fill="@gap.Fill"><title>@gap.Text</title></rect>
                }
                @foreach (var shape in TimelineLaneShapes.NotAnalysed(lane))
                {
                    <rect x="@SvgNumber.Format(shape.X)" y="@SvgNumber.Format(shape.Y)" width="@SvgNumber.Format(shape.Width)" height="@SvgNumber.Format(shape.Height)" fill="rgba(128,128,128,0.15)" />
                }
                @foreach (var shape in TimelineLaneShapes.Bars(lane))
                {
                    <rect x="@SvgNumber.Format(shape.X)" y="@SvgNumber.Format(shape.Y)" width="@SvgNumber.Format(shape.Width)" height="@SvgNumber.Format(shape.Height)" fill="rgba(128,128,128,0.8)" />
                }
                @foreach (var shape in TimelineLaneShapes.Bands(lane, span))
                {
                    <rect x="@SvgNumber.Format(shape.X)" y="@SvgNumber.Format(shape.Y)" width="@SvgNumber.Format(shape.Width)" height="@SvgNumber.Format(shape.Height)" fill="#FF8C00" />
                }
                @if (span.FractionOf(DateTimeOffset.UtcNow) is { } now)
                {
                    <rect x="@SvgNumber.Format(now * lane.Buckets.Count)" y="0" width="1" height="@SvgNumber.Format(ActivityTimelineShapes.BoxHeight)" fill="#E53935" />
                }
            </svg>
        </div>
    }

    <div class="d-flex">
        <div style="width: 160px; flex: none;"></div>
        <div style="flex: 1; position: relative; height: 20px;">
            @foreach (var tick in TimelineTicks.For(span, TimeZoneInfo.Local, CultureInfo.CurrentCulture))
            {
                <MudText Typo="Typo.caption" Style="@($"position: absolute; left: {tick.Left}; transform: translateX(-50%);")">@tick.Label</MudText>
            }
        </div>
    </div>

    @* Zoom: the part of the span shown, by its two ends, right under the lanes *@
    <div class="d-flex align-center mt-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="width: 160px; flex: none; padding-right: 8px;">@TimelineSpans.ShownText(span, TimeZoneInfo.Local, CultureInfo.CurrentCulture)</MudText>
        <div style="flex: 1;">
            <RangeSlider Maximum="@rangeMaximum"
                         Start="@rangeStart"
                         End="@rangeEnd"
                         StartLabel="@Translations.ZoomRange"
                         EndLabel="@Translations.ZoomRange"
                         RangeChanged="OnRangeChangedAsync" />
        </div>
    </div>

    <div class="d-flex flex-wrap align-center gap-3 mt-2">
        <div style="width: 160px; flex: none;"></div>
        @foreach (var reason in TimelineGapStyle.Reasons)
        {
            <div class="d-flex align-center gap-1">
                <span style="@TimelineGapStyle.Swatch(reason)"></span>
                <MudText Typo="Typo.caption">@TimelineGapStyle.Text(reason)</MudText>
            </div>
        }
    </div>
}

@code {
    // About one stretch per two pixels of a wide page.
    private const int BucketCount = 720;

    private static readonly IReadOnlyList<int> SpanChoices = [.. TimelineSpans.LastHoursChoices, 0];

    // The span chosen (the last hours, or a day: 0), and the part of it shown.
    private int spanHours = 24;
    private TimelineSpan whole = TimelineSpans.LastHours(24, DateTimeOffset.UtcNow);
    private TimelineSpan span = TimelineSpans.LastHours(24, DateTimeOffset.UtcNow);
    private DateOnly? day;

    // The range slider over the span, in minutes from its start.
    private double rangeMaximum = 24 * 60;
    private double rangeStart;
    private double rangeEnd = 24 * 60;

    // A span zoomed by the viewer stays as it is; another span or a day resets it.
    private bool zoomed;
    private Timeline? timeline;
    private bool loading = true;

    // Where previous and next count from: the last place played, else the end of the span.
    private DateTimeOffset? cursor;

    // The page grows by itself while it shows a span up to now.
    private readonly CancellationTokenSource leaving = new();
    private DateTimeOffset lastLoad;
    private bool reloadPending;

    protected override Task OnInitializedAsync()
    {
        // When the server could not send again what came meanwhile (it
        // restarted), the timeline is read again.
        EventStream.MissedEvents += OnMissedEvents;
        _ = EventStream.RunAsync(OnEventAsync, leaving.Token);
        return LoadAsync();
    }

    public void Dispose()
    {
        EventStream.MissedEvents -= OnMissedEvents;
        leaving.Cancel();
        leaving.Dispose();
    }

    private void OnMissedEvents()
        => ReloadLater(TimeSpan.Zero);

    // The event reader is shared by the page: it is not held up while the
    // page waits to read the timeline again.
    private Task OnEventAsync(SurveillanceEvent surveillanceEvent)
    {
        if (TimelineRefresh.ShouldReload(surveillanceEvent, showsNow: spanHours > 0 && !zoomed))
        {
            ReloadLater(TimelineRefresh.Wait(lastLoad, DateTimeOffset.UtcNow));
        }

        return Task.CompletedTask;
    }

    private void ReloadLater(TimeSpan wait)
    {
        if (reloadPending || leaving.IsCancellationRequested)
        {
            return;
        }

        reloadPending = true;
        _ = ReloadAfterAsync(wait, leaving.Token);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage(
        "Design",
        "CA1031:Do not catch general exception types",
        Justification = "A timeline that could not be read is read again with the next event; it must not end the page's updates.")]
    private async Task ReloadAfterAsync(
        TimeSpan wait,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(wait, cancellationToken);
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // The page was left.
        }
        catch (Exception)
        {
            // The server answered with something the page could not read: the next event reads it again.
        }
        finally
        {
            reloadPending = false;
        }
    }

    private static string LaneId(TimelineLane lane)
        => "timeline-lane-" + lane.CameraId.ToString("N");

    private async Task LoadAsync()
    {
        lastLoad = DateTimeOffset.UtcNow;
        loading = timeline is null;
        if (!zoomed)
        {
            whole = TimelineSpans.Whole(spanHours, day, DateTimeOffset.UtcNow, TimeZoneInfo.Local);
            span = whole;
            rangeMaximum = (whole.To - whole.From).TotalMinutes;
            rangeStart = 0;
            rangeEnd = rangeMaximum;
        }

        try
        {
            timeline = await Gateway.GetTimelineAsync(span.From, span.To, BucketCount);
        }
        catch (HttpRequestException)
        {
            timeline = null;
        }
        finally
        {
            loading = false;
        }
    }

    private Task OnSpanChangedAsync(int hours)
    {
        spanHours = hours;
        zoomed = false;
        cursor = null;
        if (hours == 0 && day is null)
        {
            day = DateOnly.FromDateTime(DateTime.Today);
        }

        return LoadAsync();
    }

    private Task OnDayChangedAsync(DateTime? date)
    {
        day = date is { } chosen ? DateOnly.FromDateTime(chosen) : DateOnly.FromDateTime(DateTime.Today);
        zoomed = false;
        cursor = null;
        return LoadAsync();
    }

    // A thumb was let go: the part between the thumbs is shown.
    private Task OnRangeChangedAsync((double Start, double End) range)
    {
        rangeStart = range.Start;
        rangeEnd = range.End;
        span = TimelineSpans.Within(whole, range.Start, range.End);
        zoomed = !TimelineSpans.IsWhole(range.Start, range.End, rangeMaximum);
        return LoadAsync();
    }

    // The whole span again, after zooming in with the range slider.
    private Task ResetZoomAsync()
    {
        zoomed = false;
        return LoadAsync();
    }

    private async Task PlayAtAsync(TimelineLane lane, MouseEventArgs e)
    {
        var fraction = await JS.InvokeAsync<double>("timelineInterop.fractionAt", LaneId(lane), e.ClientX);
        var moment = span.At(fraction);
        cursor = moment;

        if (TimelinePlayback.At(lane, moment) is { } playback)
        {
            await PlayAsync(lane, playback, moment);
        }
        else
        {
            Snackbar.Add(Translations.NothingRecordedThen, Severity.Info);
        }
    }

    private async Task JumpAsync(bool forward)
    {
        var from = cursor ?? (forward ? span.From : span.To);
        TimelineEvent? found;
        try
        {
            found = await Gateway.FindTimelineEventAsync(from, forward);
        }
        catch (HttpRequestException)
        {
            found = null;
        }

        if (found is null)
        {
            Snackbar.Add(Translations.NoEventWithinAWeek, Severity.Info);
            return;
        }

        cursor = found.Start;
        var lane = timeline?.Lanes.FirstOrDefault(l => l.CameraId == found.CameraId);
        await PlayAsync(lane, TimelinePlayback.Of(found), found.Start);
    }

    private async Task PlayAsync(TimelineLane? lane, TimelinePlayback playback, DateTimeOffset moment)
    {
        // What plays after it: the camera's following recordings in the span, gaps skipped.
        var following = lane is null
            ? []
            : TimelinePlayback.Following(lane, playback.FilePath)
                .Select(c => new RecordingPlaybackSegment(
                    c.FilePath,
                    RecordingDisplay.FileUrl(Gateway.ApiBaseUrl, c.FilePath, Session.MediaToken) ?? string.Empty,
                    RecordingDisplay.DownloadUrl(Gateway.ApiBaseUrl, c.FilePath, Session.MediaToken) ?? string.Empty,
                    TitleOf(lane.CameraName, c.RecordingStart),
                    c.RecordingStart))
                .ToList();

        var parameters = new DialogParameters<RecordingPlaybackDialog>
        {
            { x => x.VideoUrl, RecordingDisplay.FileUrl(Gateway.ApiBaseUrl, playback.FilePath, Session.MediaToken) ?? string.Empty },
            { x => x.DownloadUrl, RecordingDisplay.DownloadUrl(Gateway.ApiBaseUrl, playback.FilePath, Session.MediaToken) ?? string.Empty },
            { x => x.Title, TitleOf(lane?.CameraName, moment) },
            { x => x.FollowingSegments, following },
            { x => x.FileName, RecordingDisplay.FileName(playback.FilePath) },
            { x => x.PlaysInBrowser, RecordingDisplay.PlaysInBrowser(playback.FilePath) },
            { x => x.FilePath, playback.FilePath },
            { x => x.StartSeconds, playback.OffsetSeconds },
            { x => x.RecordingStart, moment.AddSeconds(-playback.OffsetSeconds) },
            { x => x.CameraId, lane?.CameraId },
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true,
        };

        await DialogService.ShowAsync<RecordingPlaybackDialog>(Translations.RecordingPlayback, parameters, options);
    }

    // Every camera from the place last clicked or played, else from the first recording in the span.
    private async Task PlayAllAsync()
    {
        var lanes = timeline?.Lanes ?? [];
        var moment = PlayAllPlan.Moment(lanes, cursor, span);
        var tiles = PlayAllPlan.Tiles(lanes, moment, path => RecordingDisplay.FileUrl(Gateway.ApiBaseUrl, path, Session.MediaToken) ?? string.Empty);
        if (tiles.Count == 0)
        {
            Snackbar.Add(Translations.NothingRecordedThen, Severity.Info);
            return;
        }

        var title = string.Format(CultureInfo.CurrentCulture, Translations.PlayAllFrom1, moment.ToLocalTime().ToString("G", CultureInfo.CurrentCulture));
        var parameters = new DialogParameters<PlayAllDialog>
        {
            { x => x.Title, title },
            { x => x.Moment, moment },
            { x => x.Tiles, tiles },
            { x => x.LimitText, PlayAllPlan.LimitText(lanes, moment) },
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true,
        };

        await DialogService.ShowAsync<PlayAllDialog>(title, parameters, options);
    }

    private static string TitleOf(string? cameraName, DateTimeOffset moment)
        => $"{(string.IsNullOrEmpty(cameraName) ? Translations.Recording : cameraName)} - {moment.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)}";
}