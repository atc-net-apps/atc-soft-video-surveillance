@* Shown instead of the pages until this browser is signed in; on a new server it creates the first admin
   (with the setup code, unless this browser runs on the server itself). *@
@inject AuthService Auth
@inject GatewayService Gateway

<MudPaper Class="pa-6 mx-auto mt-8" Style="max-width: 440px;" Elevation="2">
    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (status is null)
    {
        <MudAlert Severity="Severity.Error">@Translations.ServerDidNotAnswer</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @if (SetupRequired)
            {
                <MudText Typo="Typo.h5">@Translations.CreateTheFirstAdmin</MudText>
                <MudText Typo="Typo.body2">@Translations.CreateTheFirstAdminHelp</MudText>
                @if (status.SetupCodeRequired)
                {
                    <MudTextField @bind-Value="setupCode"
                                  Label="@Translations.SetupCode"
                                  HelperText="@SetupCodeHelp"
                                  Variant="Variant.Outlined" />
                }
            }
            else
            {
                <MudText Typo="Typo.h5">@Translations.SignInToTheServer</MudText>
            }

            <MudTextField @bind-Value="userName"
                          Label="@Translations.Username"
                          Variant="Variant.Outlined"
                          AutoFocus="@(!SetupRequired || !status.SetupCodeRequired)" />
            <MudTextField @bind-Value="password"
                          Label="@Translations.Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          HelperText="@(SetupRequired ? Translations.PasswordTooShort : null)"
                          OnKeyUp="OnPasswordKeyUpAsync" />

            @if (problem is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@problem</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@busy"
                       OnClick="SubmitAsync">
                @ButtonText
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    private bool isLoading = true;
    private SetupStatus? status;
    private bool busy;
    private string setupCode = string.Empty;
    private string userName = string.Empty;
    private string password = string.Empty;
    private string? problem;

    private string ButtonText
    {
        get
        {
            if (busy)
            {
                return Translations.SigningIn;
            }

            return SetupRequired ? Translations.CreateTheFirstAdmin : Translations.SignIn;
        }
    }

    private bool SetupRequired
        => status?.SetupRequired == true;

    private string SetupCodeHelp
        => string.Format(CultureInfo.CurrentCulture, Translations.SetupCodeHelp1, status?.SetupCodeFile);

    protected override async Task OnInitializedAsync()
    {
        status = await Gateway.GetSetupStatusAsync();
        isLoading = false;
    }

    private async Task OnPasswordKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        problem = null;
        StateHasChanged();

        problem = SetupRequired
            ? await Auth.CompleteSetupAsync(setupCode, userName, password)
            : await Auth.SignInAsync(userName, password);

        password = string.Empty;
        busy = false;
    }
}