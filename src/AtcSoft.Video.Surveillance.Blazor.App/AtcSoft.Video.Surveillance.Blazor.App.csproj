<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The satellite assemblies of the four languages, and their date and number formats -->
    <SatelliteResourceLanguages>en-GB;da-DK;de-DE</SatelliteResourceLanguages>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- The Gateway (dotnet run) answers a page address such as /cameras with index.html -->
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Severities for diagnostics in .razor files, which .editorconfig does not reach -->
    <GlobalAnalyzerConfigFiles Include="razor.globalconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtcSoft.Video.Surveillance.Resources\AtcSoft.Video.Surveillance.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="4.1.0" />
    <PackageReference Include="Atc.Rest.Client" Version="2.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Rest.Api.SourceGenerator" Version="3.3.2" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\VideoSurveillance.yaml" />
    <AdditionalFiles Include=".atc-rest-api-client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AtcSoft.Video.Surveillance.Blazor.App.Tests" />
  </ItemGroup>

</Project>