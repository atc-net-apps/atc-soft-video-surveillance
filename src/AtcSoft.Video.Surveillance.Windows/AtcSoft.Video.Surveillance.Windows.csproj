<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Windows-only parts shared by the standalone app and the server — USB camera enumeration (Media Foundation), hot-plug watching (WMI) and recording thumbnails and previews (GDI+).</Description>
    <PackageTags>video;engine;mediafoundation;dshow;usb;webcam;windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.Video.Engine\Atc.Video.Engine.csproj" />
    <ProjectReference Include="..\AtcSoft.Video.Surveillance\AtcSoft.Video.Surveillance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AtcSoft.Video.Surveillance.Windows.Tests" />
  </ItemGroup>

</Project>