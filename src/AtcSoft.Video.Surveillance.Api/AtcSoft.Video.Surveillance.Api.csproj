<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- On Windows: net10.0-windows, with USB cameras (Media Foundation, WMI), GDI+ thumbnails
         and previews, and D3D11 decoding. Elsewhere (Linux, macOS, the Docker image): net10.0,
         the same server without those (WINDOWS is not defined). -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <NoWarn>$(NoWarn);SA1649;MA0048;CA1416</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Hosting" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.8 pulls in transitively (NU1903 / GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtcSoft.Video.Surveillance.Api.Contracts\AtcSoft.Video.Surveillance.Api.Contracts.csproj" />
    <ProjectReference Include="..\AtcSoft.Video.Surveillance.Api.Domain\AtcSoft.Video.Surveillance.Api.Domain.csproj" />
    <!-- The web client, served from the server's own address (WebClientHosting). -->
    <!-- Aliased: its generated API client has the same type names as the server's contracts. -->
    <ProjectReference Include="..\AtcSoft.Video.Surveillance.Blazor.App\AtcSoft.Video.Surveillance.Blazor.App.csproj" Aliases="webclient" />
    <ProjectReference Include="..\AtcSoft.Video.Surveillance\AtcSoft.Video.Surveillance.csproj" />
    <ProjectReference Include="..\Atc.Video.Engine\Atc.Video.Engine.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- The same exe runs as a console app or as a Windows service (the server MSI). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <ProjectReference Include="..\Atc.Video.Engine.DirectX\Atc.Video.Engine.DirectX.csproj" />
    <ProjectReference Include="..\AtcSoft.Video.Surveillance.Windows\AtcSoft.Video.Surveillance.Windows.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document takes its descriptions from the XML documentation of the projects it
       references. The web client's generated API client documents the same operations as the
       contracts, and the two collide; the web client's is left out. -->
  <Target Name="LeaveWebClientOutOfOpenApiDocumentation" AfterTargets="GenerateAdditionalXmlFilesForOpenApi">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)" Condition="'%(Filename)' == 'AtcSoft.Video.Surveillance.Blazor.App'" />
    </ItemGroup>
  </Target>

</Project>